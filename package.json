{
  "name": "sudojacky-personal-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:counter": "node --test worker/index.test.js",
    "test:docs": "node --test src/content/docNavigation.test.js",
    "test:markdown": "node --test src/components/article/markdownConfig.test.js",
    "counter:login": "npx --yes wrangler@4.113.0 login --use-keyring",
    "counter:create": "npx --yes wrangler@4.113.0 d1 create sudojacky-visit-counter",
    "counter:dev": "npx --yes wrangler@4.113.0 dev",
    "counter:migrate:local": "npx --yes wrangler@4.113.0 d1 migrations apply sudojacky-visit-counter --local",
    "counter:migrate:remote": "npx --yes wrangler@4.113.0 d1 migrations apply sudojacky-visit-counter --remote",
    "counter:deploy": "npx --yes wrangler@4.113.0 deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "^3.15.0",
    "meshline": "^3.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0",
    "vite": "6.4.2"
  }
}
